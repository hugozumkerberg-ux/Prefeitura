# ==============================================================================
# GITIGNORE — PORTAL TRANSPARÊNCIA ARINOS / MG
# ==============================================================================

# Ignorar toda a pasta de dados (bancos SQLite, JSONs, fotos, etc.)
dados/
**/dados/
*.sqlite3*
**/*.sqlite3*

# Dumps volumosos de banco de dados (acima de 100MB)
database/*.sql
!database/schema.sql

# Ignorar todos os scripts em lote (.bat)
*.bat
**/*.bat

# Backups compactados ZIP e áreas temporárias de staging
backups_forenses/
relatorios_exportados/
*.bak
*.tmp
*.log

# Dependencias e lixo de sistema operacional
node_modules/
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
